{
  "name": "ecobills",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:web": "pnpm --filter @ecobills/web dev",
    "dev:api": "pnpm --filter @ecobills/api dev",
    "build": "pnpm --filter @ecobills/prisma generate && pnpm -r build",
    "lint": "eslint . && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @ecobills/prisma migrate:dev",
    "db:seed": "pnpm --filter @ecobills/api seed",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=20"
  }
}
