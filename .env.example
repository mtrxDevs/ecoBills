# Copy to .env — never commit real secrets.
#
# DATABASE_URL options:
# - Local Docker:  "postgresql://ecobills:ecobills@localhost:5432/ecobills?schema=public"
# - Supabase: BOTH URLs use the SESSION pooler (port 5432). Session mode keeps
#   full session semantics, so interactive transactions (invoice numbering)
#   keep working, and it works on IPv4 networks.
#   "postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public"
#   Do NOT point DATABASE_URL at the transaction pooler (:6543 + ?pgbouncer=true):
#   interactive transactions are unsupported in transaction mode and invoice
#   numbering would break. If your password contains special characters,
#   URL-encode it (or copy the ready-made string from the dashboard).
DATABASE_URL="postgresql://ecobills:ecobills@localhost:5432/ecobills?schema=public"
# Prisma CLI (migrate/generate) connection. Supabase: session pooler or direct.
# Local Docker: same as DATABASE_URL.
DIRECT_URL="postgresql://ecobills:ecobills@localhost:5432/ecobills?schema=public"
SESSION_SECRET="change-me-to-32-plus-random-chars-minimum"
RESEND_API_KEY=""
# The single sender for every system email (2FA codes, verification codes,
# supplier orders). Must be an address on a domain you verified in Resend
# (Dashboard → Domains → DNS records) — Resend rejects unverified senders.
# For testing only, onboarding@resend.dev works but delivers solely to your
# own Resend account email. Empty API key = stub mode: mail is logged, never sent.
# RESEND_STUB=1 forces the stub even with a key set (local end-to-end tests).
RESEND_FROM="orders@yourdomain.com"
APP_URL="http://localhost:5173"
API_URL="http://localhost:3001"
API_PORT="3001"
LLM_POLISH_API_URL=""
LLM_POLISH_API_KEY=""
BACKUP_DIR="./backups"
BACKUP_CRON="0 2 * * *"
PO_FOLLOWUP_DAYS="7"
# Single-service deploy: API also serves the web UI (same origin, no CORS).
# Keep "0" for local dev (Vite serves the UI + proxies /api).
SERVE_WEB="0"
# Session cookie SameSite. "lax" for same-origin; "none" when the frontend
# lives on another origin (Tauri app, split hosting) — none implies Secure,
# so it only works over https. Server-side only, never settable by clients.
SESSION_COOKIE_SAMESITE="lax"
# Build-time only (web): API origin for split hosting or the desktop build.
# Leave empty for same-origin (local dev, single-service deploy).
# VITE_API_URL="https://your-api.onrender.com"

# Supabase API keys (optional — only needed if we adopt Supabase Auth/Storage
# later; the database move uses DATABASE_URL alone). Never expose the SECRET
# key to the frontend (no VITE_ prefix, never commit .env).
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
