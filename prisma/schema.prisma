// Prisma schema — ecoBills v0.1.1 §5 (all fixes applied)
// Money: Int (paise). Tax: Int basis points (1800 = 18%). Qty: Decimal (weight/volume).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  owner
  staff
}

enum LedgerReason {
  sale
  purchase_receipt
  adjustment
  return
}

enum InvoiceStatus {
  draft
  unpaid
  partial
  paid
  void
}

enum POStatus {
  draft
  sent
  partial
  fulfilled
}

enum PaymentMethod {
  cash
  card
  upi
  bank_transfer
  other
}

enum BillStatus {
  unpaid
  partial
  paid
  void
}

enum QuotationStatus {
  draft
  sent
  accepted
  rejected
  expired
  converted
}


model Business {
  id             String   @id @default(cuid())
  name           String
  gstin          String?
  state          String
  address        String   @default("")
  currency       String   @default("INR")
  logoUrl        String?
  invoicePrefix  String   @default("INV")
  lowStockDays   Int      @default(7)
  poFollowupDays Int      @default(7)
  createdAt      DateTime @default(now())

  users          User[]
  customers      Customer[]
  suppliers      Supplier[]
  items          Item[]
  stockLedger    StockLedger[]
  invoices       Invoice[]
  invoiceLines   InvoiceLine[]
  payments       Payment[]
  creditNotes    CreditNote[]
  creditNoteLines CreditNoteLine[]
  purchaseOrders PurchaseOrder[]
  poLines        POLine[]
  expenses       Expense[]
  auditLogs      AuditLog[]
  counters       InvoiceCounter[]
  quotations     Quotation[]
  quotationLines QuotationLine[]
  purchaseBills  PurchaseBill[]
  purchaseBillLines PurchaseBillLine[]
  supplierPayments SupplierPayment[]
}


model User {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(staff)
  twoFactorEnabled Boolean @default(false)
  // False until the address is proven via an email_verify challenge. Accounts
  // created before verification existed are grandfathered by the seed (true).
  emailVerified Boolean @default(false)
  createdAt    DateTime @default(now())

  sessions     Session[]
  challenges   TwoFactorChallenge[]
  ledgerEntries StockLedger[] @relation("LedgerAuthor")
  auditLogs    AuditLog[]

  @@index([businessId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// Email 2FA: a short-lived 6-digit code challenge. The code is stored hashed,
// single-use (consumedAt), capped at MAX_ATTEMPTS guesses, and expires after
// CODE_TTL_MINUTES. No session exists until verification succeeds.
// `purpose` keeps signup-verification codes and sign-in codes from cross-use.
enum ChallengePurpose {
  two_factor
  email_verify
}
model TwoFactorChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    ChallengePurpose @default(two_factor)
  codeHash   String
  tokenHash  String    @unique
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String   @default("")
  email      String?
  gstin      String?
  state      String   @default("")
  address    String   @default("")
  // Net payment terms in days: invoice dueDate defaults to issueDate + terms.
  paymentTermsDays Int @default(0)
  isActive   Boolean  @default(true)
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  invoices   Invoice[]
  quotations Quotation[]

  @@index([businessId])
  @@index([businessId, name])
}

model Supplier {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  contactEmail String   @default("")
  phone        String   @default("")
  address      String   @default("")
  createdAt    DateTime @default(now())

  items          Item[]          @relation("PrimarySupplier")
  purchaseOrders PurchaseOrder[]
  purchaseBills  PurchaseBill[]
  payments       SupplierPayment[]

  @@index([businessId])
}

model Item {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  sku               String
  category          String   @default("General")
  unit              String   @default("pcs")
  hsnCode           String?
  costPrice         Int      @default(0)
  salePrice         Int      @default(0)
  taxRateBps        Int      @default(0)
  reorderThreshold  Decimal  @default(0) @db.Decimal(12, 3)
  primarySupplierId String?
  primarySupplier   Supplier? @relation("PrimarySupplier", fields: [primarySupplierId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())

  ledger      StockLedger[]
  invoiceLines InvoiceLine[]
  poLines     POLine[]
  creditLines CreditNoteLine[]
  billLines   PurchaseBillLine[]
  quoteLines  QuotationLine[]

  @@unique([businessId, sku])
  @@index([businessId])
}


model StockLedger {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  deltaQty   Decimal      @db.Decimal(12, 3)
  reason     LedgerReason
  refType    String       @default("")
  refId      String       @default("")
  createdBy  String
  author     User         @relation("LedgerAuthor", fields: [createdBy], references: [id])
  createdAt  DateTime     @default(now())

  @@index([businessId, itemId])
  @@index([itemId])
}

model InvoiceCounter {
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  financialYear  String
  lastNumber     Int      @default(0)

  @@id([businessId, financialYear])
}

model Invoice {
  id                 String        @id @default(cuid())
  businessId         String
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoiceNumber      String
  placeOfSupplyState String        @default("")
  status             InvoiceStatus @default(draft)
  issueDate          DateTime      @default(now())
  dueDate            DateTime?
  notes              String        @default("")
  // Bill-to snapshot: who the invoice was made out to, frozen at creation.
  // Old documents must not change when the customer record is edited later;
  // readers prefer these fields and fall back to the live customer only when
  // null (walk-ins and pre-snapshot invoices).
  billToName         String?
  billToGstin        String?
  billToAddress      String?
  billToState        String?
  subtotal           Int           @default(0)
  taxTotal           Int           @default(0)
  grandTotal         Int           @default(0)
  createdAt          DateTime      @default(now())


  lines    InvoiceLine[]
  payments Payment[]
  creditNotes CreditNote[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([businessId, issueDate])
}

model InvoiceLine {
  id                    String  @id @default(cuid())
  businessId            String
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId             String
  invoice               Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId                String
  item                  Item     @relation(fields: [itemId], references: [id])
  qty                   Decimal  @db.Decimal(12, 3)
  unitPriceSnapshot     Int
  unitCostSnapshot      Int
  taxRateSnapshotBps    Int

  @@index([businessId, invoiceId])
}

model Payment {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount     Int
  method     PaymentMethod @default(cash)
  paidAt     DateTime      @default(now())
  note       String        @default("")

  @@index([businessId, invoiceId])
}

model CreditNote {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  reason      String   @default("")
  issueDate   DateTime @default(now())
  subtotal    Int      @default(0)
  taxTotal    Int      @default(0)
  grandTotal  Int      @default(0)
  createdAt   DateTime @default(now())

  lines CreditNoteLine[]

  @@index([businessId])
}

model CreditNoteLine {
  id                 String     @id @default(cuid())
  businessId         String
  business           Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creditNoteId       String
  creditNote         CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  itemId             String
  item               Item       @relation(fields: [itemId], references: [id])
  qty                Decimal    @db.Decimal(12, 3)
  unitPriceSnapshot  Int
  unitCostSnapshot   Int
  taxRateSnapshotBps Int

  @@index([businessId, creditNoteId])
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  status        POStatus @default(draft)
  emailSubject  String   @default("")
  emailBody     String   @default("")
  sentAt        DateTime?
  idempotencyKey String  @unique @default(cuid())
  createdAt     DateTime @default(now())

  lines POLine[]
  bills PurchaseBill[]

  @@index([businessId])

  @@index([businessId, status])
}

model POLine {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  qtyRequested    Decimal       @db.Decimal(12, 3)
  qtyReceived     Decimal       @default(0) @db.Decimal(12, 3)
  lastKnownPrice  Int           @default(0)

  @@index([businessId, purchaseOrderId])
}

model Expense {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   String
  amount     Int
  note       String   @default("")
  date       DateTime @default(now())

  @@index([businessId, date])
}

model AuditLog {
  id        String   @id @default(cuid())
  businessId String
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([businessId, entity])
}

model PurchaseBill {
  id              String             @id @default(cuid())
  businessId      String
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  billNumber      String
  status          BillStatus         @default(unpaid)
  issueDate       DateTime           @default(now())
  dueDate         DateTime?
  subtotal        Int                @default(0)
  taxTotal        Int                @default(0)
  grandTotal      Int                @default(0)
  note            String             @default("")
  createdAt       DateTime           @default(now())

  lines           PurchaseBillLine[]
  payments        SupplierPayment[]

  @@unique([businessId, supplierId, billNumber])
  @@index([businessId])
  @@index([businessId, supplierId])
}

model PurchaseBillLine {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  billId     String
  bill       PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item         @relation(fields: [itemId], references: [id])
  qty        Decimal      @db.Decimal(12, 3)
  unitPrice  Int
  taxRateBps Int
  subtotal   Int
  tax        Int
  total      Int

  @@index([businessId, billId])
}

model SupplierPayment {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier      @relation(fields: [supplierId], references: [id])
  billId     String?
  bill       PurchaseBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  amount     Int
  method     PaymentMethod @default(bank_transfer)
  paidAt     DateTime      @default(now())
  reference  String        @default("")
  note       String        @default("")
  createdAt  DateTime      @default(now())

  @@index([businessId, supplierId])
  @@index([businessId, billId])
}

model Quotation {
  id                 String          @id @default(cuid())
  businessId         String
  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quoteNumber        String
  status             QuotationStatus @default(draft)
  issueDate          DateTime        @default(now())
  validUntil         DateTime?
  subtotal           Int             @default(0)
  taxTotal           Int             @default(0)
  grandTotal         Int             @default(0)
  notes              String          @default("")
  convertedInvoiceId String?
  createdAt          DateTime        @default(now())

  lines              QuotationLine[]

  @@unique([businessId, quoteNumber])
  @@index([businessId])
}

model QuotationLine {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  qty         Decimal   @db.Decimal(12, 3)
  unitPrice   Int
  taxRateBps  Int
  subtotal    Int
  tax         Int
  total       Int

  @@index([businessId, quotationId])
}

