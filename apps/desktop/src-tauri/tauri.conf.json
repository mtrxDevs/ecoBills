{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ecoBills",
  "version": "0.1.1",
  "identifier": "works.mtrx.ecobills",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @ecobills/web dev",
    "beforeBuildCommand": "pnpm --filter @ecobills/web build"
  },
  "app": {
    "windows": [{ "title": "ecoBills", "width": 1280, "height": 800 }],
    "trayIcon": { "iconPath": "icons/32x32.png", "tooltip": "ecoBills" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Business",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "ecoBills",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": { "active": true, "endpoints": ["https://releases.mtrx.works/ecobills/{{target}}/{{current_version}}"], "dialog": true, "pubkey": "REPLACE_WITH_UPDATE_PUBKEY" },
    "notification": {},
    "autostart": {}
  }
}
